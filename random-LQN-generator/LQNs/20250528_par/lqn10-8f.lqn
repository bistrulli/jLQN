:
    acti1 -> (0.15)acti12 + (0.17)acti13 + (0.17)acti14 + (0.17)acti15 + (0.17)acti16 + (0.17)acti17;
    acti12[Entr1];
    acti13[Entr1];
    acti14[Entr1];
    acti15[Entr1];
    acti16[Entr1];
    acti17[Entr1]
